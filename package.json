{
  "name": "sumbi-tour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/preflight.mjs dev && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "node scripts/preflight.mjs build && cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "node scripts/preflight.mjs start && cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "node scripts/preflight.mjs test && vitest run",
    "typecheck": "tsc --noEmit",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "cross-env": "10.1.0",
    "graphql": "16.15.0",
    "next": "16.4.5",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "semver": "7.8.6",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
