# 환경 변수 이름 목록(값 없음). 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 git에 올리지 않는다.
#
# --- 앱(Payload·Next.js) ---
# PostgreSQL 연결 문자열. 예시 형식: postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
# 아래 Compose 변수와 같은 사용자·비밀번호·DB 이름·포트를 쓴다.
DATABASE_URL=
# Payload 암호화·서명용 비밀 값. 충분히 긴 무작위 문자열을 쓴다.
PAYLOAD_SECRET=
# 사이트 주소. 로컬 개발은 http://localhost:3000
NEXT_PUBLIC_SERVER_URL=
#
# --- 로컬 PostgreSQL(docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# 호스트 쪽 포트. 비워 두면 5432. 5432를 다른 프로그램이 쓰고 있으면 바꾼다(DATABASE_URL의 포트도 함께).
POSTGRES_PORT=
#
# --- 선택 ---
# E2E 테스트 전용 포트. 비워 두면 3100.
E2E_PORT=
#
# --- 운영(Vercel) 전용 — 로컬 개발에서는 모두 비워 둔다 ---
# 값은 이 파일이 아니라 Vercel 프로젝트의 Environment Variables(Production, 비밀값은 Secret 유형)에만 넣는다. README "배포" 절 참고.
# 운영 빌드(VERCEL_ENV=production)에서는 DATABASE_URL·PAYLOAD_SECRET과 함께 아래 변수(DATABASE_POOL_MAX 제외)가 모두 필요하다.
# 운영의 DATABASE_URL은 Supabase 트랜잭션 풀러 주소(포트 6543)이며 끝에 ?sslmode= 같은 SSL 인자를 붙이지 않는다.
# 예약 정리 경로(/api/cron/cleanup)의 Bearer 비밀값. 영문·숫자만 16자 이상(권장 32자). 비워 두면 정리 경로는 늘 401이다.
CRON_SECRET=
# 원격 DB 인증서(PEM, -----BEGIN CERTIFICATE-----로 시작하는 글 전체). 루프백 DB에서는 쓰지 않는다.
DATABASE_CA_CERT=
# DB 연결 풀 크기(3~20 정수, 선택). 비워 두면 원격 5, 루프백은 pg 기본값.
DATABASE_POOL_MAX=
# 사진 저장소(Supabase Storage S3 호환). 다섯 개를 모두 넣으면 켜지고, 모두 비우면 로컬 media/ 폴더를 쓴다. 일부만 넣으면 오류.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
