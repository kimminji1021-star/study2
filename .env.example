# 환경 변수 이름 목록(값 없음). 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 git에 올리지 않는다.
#
# --- 앱(Payload·Next.js) ---
# PostgreSQL 연결 문자열. 예시 형식: postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
# 아래 Compose 변수와 같은 사용자·비밀번호·DB 이름·포트를 쓴다.
DATABASE_URL=
# Payload 암호화·서명용 비밀 값. 충분히 긴 무작위 문자열을 쓴다.
PAYLOAD_SECRET=
# 사이트 주소. 로컬 개발은 http://localhost:3000
NEXT_PUBLIC_SERVER_URL=
#
# --- 로컬 PostgreSQL(docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# 호스트 쪽 포트. 비워 두면 5432. 5432를 다른 프로그램이 쓰고 있으면 바꾼다(DATABASE_URL의 포트도 함께).
POSTGRES_PORT=
#
# --- 선택 ---
# E2E 테스트 전용 포트. 비워 두면 3100.
E2E_PORT=
